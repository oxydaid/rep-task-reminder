# Port aplikasi web dan REST API
PORT=8080

# Lokasi penyimpanan database SQLite
DB_PATH=data/reminders.db
WA_DB_PATH=data/whatsapp.db
BACKUP_DIR=data/backups

# Folder static build Vue 3 Frontend
STATIC_DIR=frontend/dist

# Zona waktu default aplikasi (Asia/Jakarta, Asia/Makassar, Asia/Jayapura)
DEFAULT_TIMEZONE=Asia/Jakarta
